# Keep the build context small and the image clean.
.git
.gitignore
.env
.env.*
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/

# Frontend is deployed separately via Amplify — never needed in the API image.
frontend/

# Dev-only trees.
eval/
scripts/
notebooks/
tests/
.pytest_cache/
.ipynb_checkpoints/

# Docs, except the three JSON files the API actually reads at runtime (those are
# COPYed explicitly by name in the Dockerfile, which overrides these excludes).
docs/*.md
docs/*.png

PROGRESS.md
README.md
*.log
