# --- Secrets (CRITICAL — never commit these) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Trained model artifacts (regenerated by src/train.py, don't diff well) ---
# NOTE: if the team has agreed to commit models/*.joblib so everyone shares
# one trained model, comment these two lines out — otherwise each dev's
# local train.py run stays out of git.
# models/*.joblib

# --- Logs ---
*.log
logs/

# --- Frontend (Dev 3 / Path A) ---
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/.vite/
